PORT=3001
SQL_SERVER=tvsdb2.thanvasupos.com,28914
SQL_DATABASE=BD_AIR
SQL_USER=uinet
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_ENCRYPT=Yes
SQL_TRUST_CERT=Yes
JWT_SECRET=change-me-in-production
FRONTEND_ORIGIN=http://localhost:5173
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=http://localhost:3001/api/auth/line/callback
LINE_LOGIN_SCOPES=profile openid
# Messaging API (LINE OA push + webhook + rich menu). Channel access token from LINE Developers.
LINE_CHANNEL_ACCESS_TOKEN=
# LIFF app ID (LINE Developers → LIFF). Endpoint URL = FRONTEND_ORIGIN
LIFF_ID=
# Rich Menu image PNG 2500×1686 (public URL). Required to publish menu from Settings.
LINE_RICH_MENU_IMAGE_URL=
# LINE OA add-friend QR (from Official Account Manager)
LINE_OA_QR_URL=https://qr-official.line.me/gs/M_485qewwd_GW.png?oat_content=qr
LINE_OA_ADD_FRIEND_URL=
# Docker Linux uses tedious. Windows local can omit this.
SQL_CLIENT=tedious
# Google Calendar OAuth (Google Cloud Console → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI must match Google Cloud Console exactly (via Vite proxy on :5173):
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/teacher/google/callback
# Also add http://localhost:5173/api/google/callback if you use that path.
# Production (kruair.thanvasupos.com) is set in docker-compose.prod.yml:
# FRONTEND_ORIGIN=https://kruair.thanvasupos.com
# LINE_CALLBACK_URL=https://kruair.thanvasupos.com/api/auth/line/callback
